---
---
<section class="container-x py-20">
  <div class="relative overflow-hidden rounded-2xl text-center py-16 px-6"
       style="border: 1px solid var(--border-subtle); background: var(--bg-surface);">
    <div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
    <div class="absolute inset-x-0 top-0 h-32 pointer-events-none"
         style="background: radial-gradient(circle at 50% 0%, rgba(60,207,171,0.08), transparent 60%);"></div>
    <div class="relative">
      <h2 class="heading-section">Try Mexus now.</h2>
      <p class="mt-4 text-secondary max-w-md mx-auto">One CLI. Any agent. Every project.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="#install" class="btn-primary">Install Mexus</a>
        <a href="https://github.com/yofine/Nexus" class="btn-ghost">Star on GitHub</a>
      </div>
      <div class="mt-6 inline-flex chip font-mono">
        <span class="text-muted">$</span>&nbsp;<span class="text-primary">npm install -g mexus-cli</span>
      </div>
    </div>
  </div>
</section>
