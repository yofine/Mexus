---
import { WorkspaceMock } from '@mexus/ui';
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 grid-bg opacity-50 pointer-events-none"></div>
  <div class="absolute inset-x-0 -top-48 h-[480px] pointer-events-none"
       style="background: radial-gradient(circle at 50% 0%, rgba(60,207,171,0.07), transparent 60%);"></div>

  <div class="container-x relative pt-20 pb-10 sm:pt-24 sm:pb-16 text-center">
    <div class="inline-flex items-center gap-2 chip font-mono">
      <span style="color: var(--accent)">●</span>
      <span>v3.7 · Hub mode + Agent Team plugin</span>
    </div>

    <h1 class="heading-display mt-7">
      The execution layer<br />
      for multi-agent development<span class="blink"></span>
    </h1>

    <p class="mt-6 max-w-2xl mx-auto text-secondary text-base sm:text-lg leading-relaxed">
      <span style="color: var(--text-primary)">M.E.X.U.S.</span> — Multi-agent Execution Unified System. Run, observe and review every CLI AI agent — Claude Code, Codex, OpenCode, Gemini, Aider, Cursor and more — from one local console.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="#install" class="btn-primary">Install Mexus</a>
      <a href="https://github.com/yofine/Nexus" class="btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12.3c0 5.18 3.36 9.57 8.02 11.12.59.11.8-.26.8-.57v-2c-3.26.72-3.94-1.57-3.94-1.57-.54-1.37-1.31-1.74-1.31-1.74-1.07-.74.08-.73.08-.73 1.18.08 1.8 1.22 1.8 1.22 1.05 1.82 2.76 1.3 3.43.99.11-.77.41-1.3.74-1.6-2.6-.3-5.34-1.32-5.34-5.85 0-1.29.45-2.35 1.2-3.18-.12-.3-.52-1.5.11-3.13 0 0 .98-.32 3.21 1.22A11.04 11.04 0 0 1 12 5.8c1 .01 2 .14 2.94.4 2.23-1.54 3.21-1.22 3.21-1.22.63 1.62.23 2.83.11 3.13.75.83 1.2 1.89 1.2 3.18 0 4.54-2.74 5.54-5.35 5.84.42.37.8 1.1.8 2.22v3.29c0 .32.21.69.81.57A11.51 11.51 0 0 0 23.5 12.3 11.5 11.5 0 0 0 12 .5Z"/></svg>
        View on GitHub
      </a>
    </div>

    <div class="mt-5 text-xs text-muted font-mono">
      <span class="text-secondary">$</span> npm install -g mexus-cli &nbsp;·&nbsp; macOS / Linux / WSL · Node 22+
    </div>
  </div>

  <div class="container-x relative pb-20">
    <WorkspaceMock client:load />

    <div class="mt-8 flex flex-wrap justify-center gap-2 text-xs">
      <span class="chip">Multi-agent parallel</span>
      <span class="chip">Git worktree isolation</span>
      <span class="chip">Statusline observability</span>
      <span class="chip">Replay history</span>
      <span class="chip">Agent Team plugin</span>
      <span class="chip">Hub for many workspaces</span>
    </div>
  </div>
</section>
