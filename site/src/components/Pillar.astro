---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  reverse?: boolean;
  anchor?: string;
  layout?: 'side' | 'stacked';
}
const { eyebrow, title, body, reverse = false, anchor, layout = 'side' } = Astro.props;
---

{layout === 'stacked' ? (
  <section id={anchor} class="container-x py-20 sm:py-24 scroll-mt-20">
    <div class="max-w-3xl mx-auto text-center">
      <div class="section-eyebrow"><span class="dot">●</span> {eyebrow}</div>
      <h2 class="heading-section mt-3">{title}</h2>
      <p class="mt-5 text-secondary leading-relaxed">{body}</p>
      <div class="mt-6 flex flex-col gap-2 items-start text-left max-w-xl mx-auto">
        <slot name="bullets" />
      </div>
    </div>
    <div class="relative mt-12">
      <div class="pane">
        <slot name="visual" />
      </div>
    </div>
  </section>
) : (
  <section id={anchor} class="container-x py-20 sm:py-24 scroll-mt-20">
    <div class={`grid md:grid-cols-5 gap-10 lg:gap-14 items-center ${reverse ? 'md:[&>*:first-child]:order-2' : ''}`}>
      <div class="md:col-span-1">
        <div class="section-eyebrow"><span class="dot">●</span> {eyebrow}</div>
        <h2 class="heading-section mt-3">{title}</h2>
        <p class="mt-5 text-secondary leading-relaxed">{body}</p>
        <div class="mt-6 flex flex-col gap-2">
          <slot name="bullets" />
        </div>
      </div>
      <div class="relative md:col-span-4">
        <div class="pane">
          <slot name="visual" />
        </div>
      </div>
    </div>
  </section>
)}
