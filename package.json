{
  "name": "mexus-cli",
  "version": "3.5.0",
  "description": "Execution layer for managing multiple CLI AI Agent instances from one local console",
  "type": "module",
  "bin": {
    "mexus": "./packages/server/dist/cli.mjs",
    "nexus": "./packages/server/dist/cli.mjs"
  },
  "files": [
    "packages/server/dist/",
    "packages/web/dist/",
    "scripts/"
  ],
  "scripts": {
    "dev": "pnpm run build:web && NEXUS_PROJECT_DIR=$PWD tsx packages/server/src/cli.ts",
    "dev:full": "NEXUS_PROJECT_DIR=$PWD pnpm -r --filter @nexus/server --filter @nexus/web --parallel dev",
    "dev:hub": "pnpm run build:web && NEXUS_HUB_PORT=${NEXUS_HUB_PORT:-7801} tsx packages/server/src/cli.ts hub",
    "debug:hub": "pnpm run build && NEXUS_HUB_PORT=${NEXUS_HUB_PORT:-7801} node packages/server/dist/cli.mjs hub",
    "build:web": "pnpm --filter @nexus/web build",
    "build:server": "pnpm --filter @nexus/server build",
    "build": "pnpm run build:web && pnpm run build:server",
    "docs:dev": "pnpm -C doc_site dev",
    "docs:build": "pnpm -C doc_site build",
    "docs:preview": "pnpm -C doc_site preview",
    "start": "NEXUS_PROJECT_DIR=$PWD node packages/server/dist/cli.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "pnpm run build",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.4.1",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.0",
    "@parcel/watcher": "^2.5.0",
    "fastify": "^5.2.0",
    "ignore": "^7.0.0",
    "ink": "^5.2.1",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.0.0",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "simple-git": "^3.27.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "@parcel/watcher"
    ]
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "terminal",
    "pty",
    "manager"
  ],
  "license": "Apache-2.0",
  "author": "yofine"
}
